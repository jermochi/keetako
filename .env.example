# Keetako — environment variables
# Copy this file to `.env` (project root) and fill in real values.
# `.env` is gitignored; this `.env.example` is committed as the template.
#
# Only EXPO_PUBLIC_* vars are bundled into the client app. They are SAFE to
# expose: the Supabase anon key is protected by Row Level Security, and the
# PostHog/RevenueCat public keys are meant for clients.
#
# SECRETS NEVER GO HERE. The Anthropic key, RevenueCat webhook secret, and
# Supabase service-role key live only in Supabase Edge Function secrets
# (`supabase secrets set NAME=value`) — never in this app or in git.

# --- Supabase (M3) ---
# Dashboard → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# --- RevenueCat (M19) ---
# RevenueCat dashboard → Project → API keys → Android public SDK key
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_your_public_sdk_key

# --- PostHog (M20) ---
# PostHog → Project settings → Project API key (the public "phc_..." key)
EXPO_PUBLIC_POSTHOG_KEY=phc_your_project_api_key
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
